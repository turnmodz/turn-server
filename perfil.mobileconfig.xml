            <string>https://turn-server-brown.vercel.app</string>
            
            <!-- Nome exibido na Home Screen -->
            <key>Label</key>
            <string>TurnModz</string>
            
            <!-- Permite que o usuário remova o atalho normalmente -->
            <key>IsRemovable</key>
            <true/>
            
